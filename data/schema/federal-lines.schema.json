{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Номера по всей стране, которых нет в now.yaml хаба",
  "type": "object",
  "properties": {
    "dataset": {
      "const": "federal-lines"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "tel",
          "label",
          "is_24x7",
          "hours_text",
          "quote_verbatim",
          "source_url",
          "retrieved_at",
          "source_ref",
          "verified",
          "verified_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "number": {
            "type": "string",
            "minLength": 3
          },
          "tel": {
            "type": "string",
            "pattern": "^(\\+7\\d{10}|\\d{3})$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "is_24x7": {
            "type": "boolean"
          },
          "hours_text": {
            "type": "string"
          },
          "quote_verbatim": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "type": "boolean"
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "eoNumber": {
            "type": "string",
            "pattern": "^\\d{16}$"
          },
          "point": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
